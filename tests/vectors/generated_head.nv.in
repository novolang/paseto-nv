// generated_vectors_tests.nv — expected values produced by vectors/generate.py.
//
// Do not edit by hand: run `python3 -I generate.py` in tests/vectors.  The
// tokens and PASERK strings come from the reference in paseto_ref.py, which is
// written from the PASETO v4 and PASERK specifications on hashlib's BLAKE2b
// and the `cryptography` package's Ed25519 and ChaCha20.  Loading the
// reference checks HChaCha20 against draft-irtf-cfrg-xchacha section 2.2.1
// and reproduces the published token of PASETO test vector 4-S-1.
//
// Rows are: key or seed, nonce or public key, message, footer, implicit
// assertion (all hex), the token, and `ok` when the message is a claims
// payload that the policy used below accepts or `plain` when it is not.

use std.bytes
use std.str
use std.test
use paserr
use pasclaims
use paskey
use paspolicy
use pasetoken
use paserk

fn hex(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

