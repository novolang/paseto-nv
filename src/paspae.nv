// paspae.nv — PAE, the Pre-Authentication Encoding, which is the one
// piece of PASETO that is neither a cipher nor a signature and the one
// a port gets wrong.
//
// What it is and why it exists.  Every PASETO token authenticates
// several pieces at once: the header, the nonce, the ciphertext, the
// footer, and the implicit assertion.  Concatenating them and MACing
// the result is the classic mistake — `("ab", "c")` and `("a", "bc")`
// concatenate to the same bytes, so an attacker who can move a byte
// from one piece to another produces a different token with the same
// MAC.  On a token that is
//
//     header || nonce || ciphertext || footer
//
// that is a footer byte moved into the ciphertext and back, which is a
// forgery.
//
// PAE makes the split unambiguous:
//
//     le64(count) || for each piece: le64(len(piece)) || piece
//
// so the lengths are inside what is authenticated and no two different
// tuples encode to the same bytes.
//
// The top bit of every length is cleared.  PASETO's specification says
// so explicitly, and the reason is JavaScript: a length above 2^53
// cannot be represented exactly as a double, and a language whose
// integers are doubles would encode a different number than it read.
// Clearing bit 63 makes every implementation agree.  `MAX_PIECE_BYTES`
// is that bound, and `encode` refuses past it rather than truncating.
//
// Public because the specification gives vectors for it.  PAE of the
// empty list, of one empty string, and of `["", ""]` are three of the
// test cases every PASETO implementation runs, and a port that passes
// them has the hardest part right.  It is also what a caller
// implementing a v3 profile or an extension would need, and there is
// no reason to make them write it again.

use std.bytes
use std.list
use paserr

// ── Limits ───────────────────────────────────────────────────────────

// The longest a single piece may be: 2^63 - 1, the largest value a
// length with its top bit cleared can name.
//
// Unreachable from this package's own calls — a token is not eight
// exabytes — and stated because the specification states it, and
// because `encode` refuses rather than truncating.
pub const PAE_MAX_PIECE_BYTES = 9223372036854775807

// One length or count: eight bytes, little-endian, bit 63 cleared,
// whatever the byte order of the cursor.
fn put_le64(var dst: Cursor, n: Int)
    let v = n & PAE_MAX_PIECE_BYTES
    for k in 0..8
        dst.put_u8((v >>> (8 * k)) & 0xFF)

// ── Encoding ─────────────────────────────────────────────────────────

// How many bytes `encode_into` writes for these pieces: eight for the
// count, then eight plus its length for each.
//
// Call it, size one buffer, write once.
//
// ```novo
// use std.bytes
// use paspae
//
// fn main() [io]
//     println("${paspae.encode_len([])}")         // 8
// ```
pub fn encode_len(pieces: [Bytes]) -> Int []
    var n = 8
    for p in pieces
        n = n + 8 + bytes.len(p)
    n

// Write the pre-authentication encoding of `pieces` at `dst`'s
// position; the count comes back.
//
// The count and every length are little-endian 64-bit, top bit
// cleared.  `PasPaeTooLong` if a piece is longer than
// `PAE_MAX_PIECE_BYTES`; `PasOutputTooSmall` if the buffer is short,
// and then nothing is written.
//
// ```novo
// use std.bytes
// use paspae
//
// fn main() [io]
//     var c = bytes.cursor_le(bytes.zeros(paspae.encode_len([])))
//     match paspae.encode_into([], c)
//         Ok(n)  => println("${n}")               // 8
//         Err(_) => println("refused")
// ```
pub fn encode_into(pieces: [Bytes], var dst: Cursor) -> Result<Int, PasError> []
    let want = encode_len(pieces)
    let have = dst.remaining()
    if have < want
        Err(PasOutputTooSmall(want, have))
    else
        put_le64(var dst, list.len(pieces))
        for p in pieces
            put_le64(var dst, bytes.len(p))
            dst.put_bytes(p)
        Ok(want)

// The pre-authentication encoding of `pieces`, in a buffer of its own.
//
// The convenience shape, and the only function in this module that
// allocates.  A caller inside a request handler uses `encode_into`
// with a buffer it reuses; a test uses this.
//
// ```novo
// use std.bytes
// use paspae
//
// fn main() [io]
//     match paspae.encode([])
//         Ok(b)  => println(bytes.to_hex(b))      // 0000000000000000
//         Err(_) => println("refused")
// ```
pub fn encode(pieces: [Bytes]) -> Result<Bytes, PasError> []
    var c = bytes.cursor_le(bytes.zeros(encode_len(pieces)))
    match encode_into(pieces, var c)
        Ok(_)  => Ok(c.finish())
        // cov: skip — the buffer is sized by `encode_len`, so the encoding is never refused
        Err(e) => Err(e)

// One length field: `n` as a little-endian 64-bit number with bit 63
// cleared, written into `out`.
//
// Public so that the JavaScript rule the module header describes can
// be tested on its own, and so that a caller writing a v3 profile has
// the primitive rather than a comment telling them what to write.
//
// `out` must be at least 8 bytes and comes back.
//
// ```novo
// use std.bytes
// use paspae
//
// fn main() [io]
//     println(bytes.to_hex(paspae.length_field(1, bytes.zeros(8))))   // 0100000000000000
// ```
pub fn length_field(n: Int, out: Bytes) -> Bytes []
    var buf = if bytes.len(out) >= 8
        bytes.clone(out)
    else
        out + bytes.zeros(8 - bytes.len(out))
    buf = bytes.set_u64_le(buf, 0, n & PAE_MAX_PIECE_BYTES)
    buf
