// pasetoken.nv — the token: decoding, the two verifications, and the
// two ways to make one.
//
// The load-bearing interface: the unverified state is unusable.
//
// This is jwt-nv's design, deliberately matched so that a consumer can
// switch formats by changing a type name and nothing else.  There are
// two token types and only one can be asked for claims:
//
//     decode(token)                 -> UnverifiedPaseto
//     verify(t, key, policy, now)   -> VerifiedPaseto
//     decrypt(t, key, policy, now)  -> VerifiedPaseto
//     claims_of(t: VerifiedPaseto)  -> PasClaims
//
// `claims_of` takes a `VerifiedPaseto`; nothing but `verify` and
// `decrypt` produce one.  So a caller holding claims has been through
// a check with a key it chose and a policy it wrote — not because it
// remembered to, but because it could not write the other program.
//
// What PASETO adds that jwt-nv cannot.  In a JWT the payload is
// base64: anyone holding the token reads the claims, verified or not,
// and the `dangerous_unverified_payload_json` escape hatch jwt-nv
// documents is a hatch onto something that was never hidden.  A
// `v4.local` PASETO is encrypted, so the unverified state has nothing
// to leak — there is no way to read those claims without the key, and
// that is a property of the format rather than of this api.  A
// `v4.public` token is signed and not encrypted, so it behaves like a
// JWT, and `dangerous_unverified_payload_json` says so by refusing on a
// local token rather than pretending.
//
// v4.local is encrypt-then-mac, not an AEAD, and that surprises people
// who expect XChaCha20-Poly1305:
//
//   * two subkeys come out of the key and the 32-byte nonce —
//     `tmp = BLAKE2b(key, "paseto-encryption-key" || n, 56)` gives the
//     encryption key `tmp[0..32]` and a second nonce `tmp[32..56]`,
//     and `Ak = BLAKE2b(key, "paseto-auth-key-for-aead" || n, 32)`;
//   * the message is XChaCha20 — the raw stream cipher, which is why
//     chacha20-nv publishes `cc20x.xapply_into` separately;
//   * the tag is `BLAKE2b(Ak, PAE([header, n, ciphertext, footer,
//     implicit]), 32)`, and PAE is why moving a byte from the footer
//     into the ciphertext does not produce a valid token.

use std.bytes
use std.list
use std.str
use b2bytes
use base64
use cc20x
use digest
use ed25519
use paspae
use paskey
use pasclaims
use paspolicy
use paserr

// ── Helpers ──────────────────────────────────────────────────────────

// base64url without padding.
fn b64(b: Bytes) -> Str []
    base64.encode(b, B64UrlSafe, B64Unpadded)

// The character offset a base64 refusal names.
fn b64_offset(e: B64Error) -> Int []
    match e
        B64BadCharacter(at, _)     => at
        B64NonCanonicalTail(at, _) => at
        B64BadLength(n)            => n
        // cov: skip — padding is refused before decoding, and `decode` allocates its own buffer
        _                          => 0

// One base64url part of a token, decoded.  A padding character is
// refused: a PASETO is unpadded throughout.
fn unb64(part: Str, s: Str) -> Result<Bytes, PasError> []
    match str.index(s, "=")
        Some(at) => Err(PasBadBase64(part, at))
        None     =>
            match base64.decode(s, B64UrlSafe)
                Ok(b)  => Ok(b)
                Err(e) => Err(PasBadBase64(part, b64_offset(e)))

// Keyed BLAKE2b of `msg` under `key`, `n` bytes long.
fn keyed_hash(key: Bytes, msg: Bytes, n: Int) -> Bytes []
    match b2bytes.blake2b_keyed_into(key, msg, bytes.zeros(n))
        Ok(d)  => d
        // cov: skip — the key is 32 bytes and `n` is 32 or 56, which BLAKE2b admits
        Err(_) => bytes.zeros(n)

// XChaCha20 over `src`: the raw stream cipher, counter 0.
fn stream_xor(key: Bytes, nonce24: Bytes, src: Bytes) -> Bytes []
    var out = bytes.cursor_le(bytes.zeros(bytes.len(src)))
    match cc20x.xapply_into(key, nonce24, 0, src, var out)
        Ok(_)  => out.finish()
        // cov: skip — the key is 32 bytes, the nonce 24, and a token is far below 2^38 bytes
        Err(_) => bytes.zeros(0)

fn labelled(label: Str, nonce: Bytes) -> Bytes []
    bytes.from_str(label) + nonce

// v4.local's two subkeys from the key and the nonce (PASETO v4
// section "Encrypt"): 56 bytes of which the first 32 are the
// encryption key and the last 24 the stream nonce, and a 32-byte
// authentication key.
struct LocalKeys
    ek: Bytes
    n2: Bytes
    ak: Bytes

fn local_keys(key: Bytes, nonce: Bytes) -> LocalKeys []
    let tmp = keyed_hash(key, labelled("paseto-encryption-key", nonce), 56)
    LocalKeys { ek: bytes.slice(tmp, 0, 32), n2: bytes.slice(tmp, 32, 56),
                ak: keyed_hash(key, labelled("paseto-auth-key-for-aead", nonce), 32) }

// The token text from the prefix, three byte strings and the footer.
fn assemble(p: PasPurpose, a: Bytes, b: Bytes, c: Bytes, footer: PasFooter) -> Str []
    let body = paskey.prefix(PasV4, p) + b64(a + b + c)
    if pasclaims.footer_is_empty(footer)
        body
    else
        body + "." + b64(bytes.from_str(pasclaims.footer_text(footer)))

// Split a token whose prefix and part count are already good.
fn decode_parts(token: Str, purpose: PasPurpose,
                parts: [Str]) -> Result<UnverifiedPaseto, PasError> []
    match unb64("payload", parts[2])
        Err(e)      => Err(e)
        Ok(payload) =>
            if bytes.len(payload) < PAS_SIGNATURE_BYTES
                Err(PasPayloadTooShort(bytes.len(payload), PAS_SIGNATURE_BYTES))
            else if list.len(parts) == 3
                Ok(UnverifiedPaseto { raw: token, payload: payload, footer: "" })
            else
                match unb64("footer", parts[3])
                    Err(e)   => Err(e)
                    Ok(foot) => Ok(UnverifiedPaseto { raw: token, payload: payload, footer: bytes.to_str(foot) })

// Why a policy refuses a claims set, or `None` when it accepts it.
// The issuer and audience first, then the three times, then the
// claims the policy requires.
fn identity_error(c: PasClaims, p: PasPolicy) -> ?PasError []
    let iss = pasclaims.issuer(c)
    let aud = pasclaims.audience(c)
    if iss == ""
        Some(PasClaimMissing(PAS_CLAIM_ISSUER))
    else if iss != paspolicy.issuer(p)
        Some(PasClaimMismatch(PAS_CLAIM_ISSUER, paspolicy.issuer(p), iss))
    else if aud == ""
        Some(PasClaimMissing(PAS_CLAIM_AUDIENCE))
    else if aud != paspolicy.audience(p)
        Some(PasClaimMismatch(PAS_CLAIM_AUDIENCE, paspolicy.audience(p), aud))
    else
        None

fn expiry_error(c: PasClaims, p: PasPolicy, now: Int) -> ?PasError []
    match pasclaims.expiration(c)
        Some(e) =>
            if now >= pasclaims.unix_seconds(e) + paspolicy.leeway_seconds(p)
                Some(PasExpired(pasclaims.unix_seconds(e), now))
            else
                None
        None    =>
            if paspolicy.requires_expiration(p)
                Some(PasClaimMissing(PAS_CLAIM_EXPIRATION))
            else
                None

fn not_before_error(c: PasClaims, p: PasPolicy, now: Int) -> ?PasError []
    match pasclaims.not_before(c)
        Some(n) =>
            if now + paspolicy.leeway_seconds(p) < pasclaims.unix_seconds(n)
                Some(PasNotYetValid(pasclaims.unix_seconds(n), now))
            else
                None
        None    =>
            if paspolicy.requires_not_before(p)
                Some(PasClaimMissing(PAS_CLAIM_NOT_BEFORE))
            else
                None

fn required_error(c: PasClaims, p: PasPolicy) -> ?PasError []
    if paspolicy.requires_issued_at(p) and pasclaims.issued_at(c) == None
        Some(PasClaimMissing(PAS_CLAIM_ISSUED_AT))
    else if paspolicy.requires_subject(p) and pasclaims.subject(c) == ""
        Some(PasClaimMissing(PAS_CLAIM_SUBJECT))
    else
        None

fn policy_error(c: PasClaims, p: PasPolicy, now: PasInstant) -> ?PasError []
    let t = pasclaims.unix_seconds(now)
    let a = identity_error(c, p)
    let b = expiry_error(c, p, t)
    let d = not_before_error(c, p, t)
    if a != None
        a
    else if b != None
        b
    else if d != None
        d
    else
        required_error(c, p)

// Parse the authenticated payload and apply the policy to it.
fn accept(text: Str, footer: Str, policy: PasPolicy,
          now: PasInstant) -> Result<VerifiedPaseto, PasError> []
    match paspolicy.check(policy)
        Err(e) => Err(e)
        Ok(_)  =>
            match pasclaims.parse(text)
                Err(e) => Err(e)
                Ok(c)  =>
                    match policy_error(c, policy, now)
                        Some(e) => Err(e)
                        None    => Ok(VerifiedPaseto { claims: c, footer: PasFooter { text: footer } })

fn open_local(t: UnverifiedPaseto, key: PasLocalKey, policy: PasPolicy, implicit: PasImplicit,
              now: PasInstant) -> Result<VerifiedPaseto, PasError> []
    let n = bytes.len(t.payload)
    let nonce = bytes.slice(t.payload, 0, PAS_NONCE_BYTES)
    let cipher = bytes.slice(t.payload, PAS_NONCE_BYTES, n - PAS_MAC_BYTES)
    let tag = bytes.slice(t.payload, n - PAS_MAC_BYTES, n)
    let ks = local_keys(paskey.local_key_bytes(key), nonce)
    match pre_auth(PasV4, PasLocal, bytes.slice(t.payload, 0, n - PAS_MAC_BYTES),
                   PasFooter { text: t.footer }, implicit)
        // cov: skip — the encoding is sized from its own pieces, so it is never refused
        Err(e)  => Err(e)
        Ok(pre) =>
            if digest.ct_eq(keyed_hash(ks.ak, pre, PAS_MAC_BYTES), tag)
                accept(bytes.to_str(stream_xor(ks.ek, ks.n2, cipher)), t.footer, policy, now)
            else
                Err(PasBadMac)

fn open_public(t: UnverifiedPaseto, key: PasPublicKey, policy: PasPolicy, implicit: PasImplicit,
               now: PasInstant) -> Result<VerifiedPaseto, PasError> []
    let n = bytes.len(t.payload)
    let msg = bytes.slice(t.payload, 0, n - PAS_SIGNATURE_BYTES)
    match pre_auth(PasV4, PasPublic, msg, PasFooter { text: t.footer }, implicit)
        // cov: skip — the encoding is sized from its own pieces, so it is never refused
        Err(e)  => Err(e)
        Ok(pre) =>
            match signature_ok(key, pre, bytes.slice(t.payload, n - PAS_SIGNATURE_BYTES, n))
                true  => accept(bytes.to_str(msg), t.footer, policy, now)
                false => Err(PasBadSignature)

// Whether `sig` verifies over `pre` under the key, at `EdStrict`.
fn signature_ok(key: PasPublicKey, pre: Bytes, sig: Bytes) -> Bool []
    match ed25519.signature_from_bytes(bytes.to_byte_list(sig))
        // cov: skip — the payload carries exactly 64 signature bytes
        Err(_) => false
        Ok(s)  =>
            match ed25519.verify(key.key, bytes.to_byte_list(pre), s, paskey.signature_strictness())
                Ok(ok) => ok
                Err(_) => false

fn seal_local(key: Bytes, claims_json: Str, footer: PasFooter, implicit: PasImplicit,
              nonce: Bytes) -> Result<Str, PasError> []
    let ks = local_keys(key, nonce)
    let cipher = stream_xor(ks.ek, ks.n2, bytes.from_str(claims_json))
    match pre_auth(PasV4, PasLocal, nonce + cipher, footer, implicit)
        // cov: skip — the encoding is sized from its own pieces, so it is never refused
        Err(e)  => Err(e)
        Ok(pre) => Ok(assemble(PasLocal, nonce, cipher, keyed_hash(ks.ak, pre, PAS_MAC_BYTES), footer))

// ── The two token types ──────────────────────────────────────────────

// A token that has been split into its parts and nothing more.
//
// Its claims cannot be read.  `prefix_of`, `footer_of` and
// `has_footer` work, because choosing which key to verify with means
// reading the footer's `kid` — a token that showed nothing could never
// be verified at all — and none of them lets a caller act on the
// payload.
//
// ```novo
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.local.abc")
//         Ok(t)  => println(pasetoken.prefix_of(t))
//         Err(_) => println("not a token")
// ```
pub struct UnverifiedPaseto
    // The whole token, as it arrived.
    raw: Str
    // The payload's decoded bytes: for v4.local the nonce, ciphertext
    // and MAC; for v4.public the message and its signature.
    payload: Bytes
    // The footer's decoded text, or `""`.
    footer: Str

// A token whose MAC or signature has been checked and whose policy has
// been satisfied.
//
// The only thing `claims_of` accepts, and the only thing `verify` and
// `decrypt` produce.
//
// ```novo
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.public.abc")
//         Ok(_)  => println("decoded; claims still unreachable")
//         Err(_) => println("not a token")
// ```
pub struct VerifiedPaseto
    // The claims, parsed.
    claims: PasClaims
    // The footer, which was authenticated but not encrypted.
    footer: PasFooter

// ── Decoding ─────────────────────────────────────────────────────────

// Split a token into its parts, checking nothing.
//
// Refuses a prefix this package does not know — `v2.local.` and
// `v3.public.` are real PASETO and are named as such rather than
// called malformed — a part count that is not three or four, a part
// that is not unpadded base64url, and a payload too short for its
// version's fixed fields.
//
// ```novo
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.local.abc")
//         Ok(_)  => println("a v4 local token")
//         Err(_) => println("not a token this package reads")
// ```
pub fn decode(token: Str) -> Result<UnverifiedPaseto, PasError> []
    let parts = str.split(token, ".")
    let n = list.len(parts)
    if n != 3 and n != 4
        Err(PasBadPartCount(n))
    else
        match paskey.parse_prefix(token)
            Err(e) => Err(e)
            Ok(vp) => decode_parts(token, vp.1, parts)

// The version and purpose prefix an unverified token carries.
//
// ```novo
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.local.abc")
//         Ok(t)  => println(pasetoken.prefix_of(t))     // v4.local.
//         Err(_) => println("not a token")
// ```
pub fn prefix_of(t: UnverifiedPaseto) -> Str []
    paskey.prefix(PasV4, purpose_of(t))

// The purpose an unverified token is for.
//
// ```novo
// use paskey
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.local.abc")
//         Ok(t)  => println(paskey.purpose_name(pasetoken.purpose_of(t)))
//         Err(_) => println("not a token")
// ```
pub fn purpose_of(t: UnverifiedPaseto) -> PasPurpose []
    if str.starts_with(t.raw, "v4.local.")
        PasLocal
    else
        PasPublic

// The version an unverified token names.
//
// ```novo
// use paskey
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.local.abc")
//         Ok(t)  => println(paskey.version_name(pasetoken.version_of(t)))
//         Err(_) => println("not a token")
// ```
pub fn version_of(t: UnverifiedPaseto) -> PasVersion []
    PasV4

// The footer of an unverified token.
//
// Readable before verification, and it has to be: the footer is where
// a `kid` lives, and choosing a key requires reading it.  The footer
// is authenticated once the token verifies, so a caller may use it to
// pick a key and must not use it as a claim about the world until
// then — which is the same rule jwt-nv's `kid_of` states.
//
// ```novo
// use pasclaims
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.local.abc")
//         Ok(t)  => println(pasclaims.footer_text(pasetoken.unverified_footer(t)))
//         Err(_) => println("not a token")
// ```
pub fn unverified_footer(t: UnverifiedPaseto) -> PasFooter []
    PasFooter { text: t.footer }

// Whether an unverified token has a footer at all.
//
// ```novo
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.local.abc")
//         Ok(t)  => println("${pasetoken.has_footer(t)}")
//         Err(_) => println("not a token")
// ```
pub fn has_footer(t: UnverifiedPaseto) -> Bool []
    t.footer != ""

// The payload of an unverified public token, as JSON text.
//
// The one escape hatch, and it is named so it cannot be mistaken.  It
// returns text rather than `PasClaims`, so it cannot be handed to
// anything expecting verified claims, and it refuses a local token —
// whose payload is encrypted and which this function could not read
// even if it wanted to.  That refusal is worth more than it looks: it
// is where a caller finds out that the two purposes are not
// interchangeable.
//
// It exists because introspection endpoints, migrations reading tokens
// signed by destroyed keys, and test fixtures genuinely need it, and
// refusing outright would send those callers to a hand-rolled base64
// split with no length checks and no name a reviewer would notice.
//
// ```novo
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.public.abc")
//         Ok(t)  =>
//             match pasetoken.dangerous_unverified_payload_json(t)
//                 Ok(s)  => println(s)
//                 Err(_) => println("a local token's payload is encrypted")
//         Err(_) => println("not a token")
// ```
pub fn dangerous_unverified_payload_json(t: UnverifiedPaseto) -> Result<Str, PasError> []
    match purpose_of(t)
        PasLocal  => Err(PasPurposeMismatch("local", "public"))
        PasPublic => Ok(bytes.to_str(bytes.slice(t.payload, 0, bytes.len(t.payload) - PAS_SIGNATURE_BYTES)))

// ── The two checks ───────────────────────────────────────────────────

// Decrypt and authenticate a `v4.local` token, then apply the policy.
//
// `PasPurposeMismatch` on a public token — a local key cannot open one
// and there is no configuration in which it could.  `PasBadMac` on a
// tag that did not match, carrying nothing: there is exactly one thing
// a caller may learn, and the claims are not decrypted at all when it
// fails.
//
// The implicit assertion is an argument and both ends must supply the
// same one; `pasclaims.no_implicit()` is the value for a protocol that
// does not use them.
//
// ```novo
// use std.bytes
// use pasclaims
// use paskey
// use paspolicy
// use pasetoken
//
// fn main() [io]
//     match paskey.local_key(bytes.zeros(32))
//         Ok(k) =>
//             match pasetoken.decode("v4.local.abc")
//                 Ok(t)  =>
//                     match pasetoken.decrypt(t, k, paspolicy.strict(),
//                                             pasclaims.no_implicit(),
//                                             pasclaims.instant(0))
//                         Ok(_)  => println("authentic and within policy")
//                         Err(_) => println("refused")
//                 Err(_) => println("not a token")
//         Err(_) => println("not 32 bytes")
// ```
pub fn decrypt(t: UnverifiedPaseto, key: PasLocalKey, policy: PasPolicy, implicit: PasImplicit,
               now: PasInstant) -> Result<VerifiedPaseto, PasError> []
    match purpose_of(t)
        PasPublic => Err(PasPurposeMismatch("public", "local"))
        PasLocal  => open_local(t, key, policy, implicit, now)

// Check a `v4.public` token's signature, then apply the policy.
//
// `PasPurposeMismatch` on a local token.  `PasBadSignature` on a
// signature that did not verify, carrying nothing.  The strictness is
// `paskey.signature_strictness()` — `EdStrict`, fixed, for the reason
// that function gives.
//
// ```novo
// use std.list
// use pasclaims
// use paskey
// use paspolicy
// use pasetoken
//
// fn main() [io]
//     match paskey.public_key(list.zeros(32))
//         Ok(k) =>
//             match pasetoken.decode("v4.public.abc")
//                 Ok(t)  =>
//                     match pasetoken.verify(t, k, paspolicy.strict(),
//                                            pasclaims.no_implicit(),
//                                            pasclaims.instant(0))
//                         Ok(_)  => println("authentic and within policy")
//                         Err(_) => println("refused")
//                 Err(_) => println("not a token")
//         Err(_) => println("not a point")
// ```
pub fn verify(t: UnverifiedPaseto, key: PasPublicKey, policy: PasPolicy, implicit: PasImplicit,
              now: PasInstant) -> Result<VerifiedPaseto, PasError> []
    match purpose_of(t)
        PasLocal  => Err(PasPurposeMismatch("local", "public"))
        PasPublic => open_public(t, key, policy, implicit, now)

// The claims of a verified token.
//
// The function the whole design is about.  It takes a
// `VerifiedPaseto`, and there is no other way to obtain a `PasClaims`
// from a token and no way to obtain a `VerifiedPaseto` except from
// `verify` or `decrypt`.
//
// ```novo
// use pasclaims
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.public.abc")
//         Ok(_)  => println("a VerifiedPaseto is what claims_of takes")
//         Err(_) => println("not a token")
// ```
pub fn claims_of(t: VerifiedPaseto) -> PasClaims []
    t.claims

// The footer of a verified token — authenticated, and safe to act on.
//
// The same text `unverified_footer` returns, and a different promise:
// this one came through a MAC or a signature.
//
// ```novo
// use pasclaims
// use pasetoken
//
// fn main() [io]
//     match pasetoken.decode("v4.public.abc")
//         Ok(_)  => println("footer_of takes a VerifiedPaseto")
//         Err(_) => println("not a token")
// ```
pub fn footer_of(t: VerifiedPaseto) -> PasFooter []
    t.footer

// ── Making a token ───────────────────────────────────────────────────

// Encrypt a claims payload as a `v4.local` token.
//
// The 32 random bytes are an argument.  A `core` package has no
// random-number effect, so the nonce is the caller's — spent once, visibly, in
// the host — and the consequence is one a test wants anyway: the
// specification's own vectors can be reproduced byte for byte by
// replaying their nonce, which no library that picks its own can do.
//
// A repeated nonce is catastrophic and this package cannot stop you.
// v4.local derives both the encryption key and the authentication key
// from the key and the nonce, so a repeated nonce is a repeated
// keystream and a repeated authentication key.  32 bytes is safe to
// pick uniformly at random, which is the discipline to use.
//
// ```novo
// use std.bytes
// use pasclaims
// use paskey
// use pasetoken
//
// fn main() [io]
//     match paskey.local_key(bytes.zeros(32))
//         Ok(k) =>
//             match pasetoken.encrypt(k, "{}", pasclaims.no_footer(),
//                                     pasclaims.no_implicit(), bytes.zeros(32))
//                 Ok(s)  => println(s)
//                 Err(_) => println("refused")
//         Err(_) => println("not 32 bytes")
// ```
pub fn encrypt(key: PasLocalKey, claims_json: Str, footer: PasFooter, implicit: PasImplicit,
               nonce: Bytes) -> Result<Str, PasError> []
    let n = bytes.len(nonce)
    if n != PAS_NONCE_BYTES
        Err(PasKeyLengthWrong(n, PAS_NONCE_BYTES))
    else
        seal_local(paskey.local_key_bytes(key), claims_json, footer, implicit, nonce)

// Sign a claims payload as a `v4.public` token.
//
// No nonce: Ed25519 is deterministic, so this needs no entropy at all
// and the same inputs give the same token every time.  That is worth
// saying because it is the one place PASETO is easier than a JWT to
// use safely — there is nothing to get wrong.
//
// ```novo
// use std.list
// use pasclaims
// use paskey
// use pasetoken
//
// fn main() [io]
//     match paskey.secret_key(list.zeros(32))
//         Ok(k) =>
//             match pasetoken.sign(k, "{}", pasclaims.no_footer(), pasclaims.no_implicit())
//                 Ok(s)  => println(s)
//                 Err(_) => println("refused")
//         Err(_) => println("not a seed")
// ```
pub fn sign(key: PasSecretKey, claims_json: Str, footer: PasFooter,
            implicit: PasImplicit) -> Result<Str, PasError> []
    let m = bytes.from_str(claims_json)
    match pre_auth(PasV4, PasPublic, m, footer, implicit)
        // cov: skip — the encoding is sized from its own pieces, so it is never refused
        Err(e)  => Err(e)
        Ok(pre) =>
            let sig = bytes.from_byte_list(ed25519.signature_bytes(ed25519.sign(paskey.signing_key_of(key), bytes.to_byte_list(pre))))
            Ok(assemble(PasPublic, m, sig, bytes.zeros(0), footer))

// The exact bytes a token's MAC or signature is taken over: `PAE` of
// the header, the payload parts, the footer and the implicit
// assertion.
//
// Public and exact, because this is where a port disagrees with every
// other implementation and cannot tell why.  A pre-authentication
// encoding that omitted the implicit assertion, or put the footer
// before the ciphertext, produces tokens this implementation reads
// perfectly and nothing else does — and the error a user sees is
// "invalid MAC", which names nothing.  Handing the bytes out means a
// test can diff them against the specification's vectors.
//
// ```novo
// use std.bytes
// use paskey
// use pasclaims
// use pasetoken
//
// fn main() [io]
//     match pasetoken.pre_auth(PasV4, PasPublic, bytes.zeros(0),
//                              pasclaims.no_footer(), pasclaims.no_implicit())
//         Ok(b)  => println("${bytes.len(b)}")
//         Err(_) => println("refused")
// ```
pub fn pre_auth(v: PasVersion, p: PasPurpose, payload: Bytes, footer: PasFooter,
                implicit: PasImplicit) -> Result<Bytes, PasError> []
    let h = bytes.from_str(paskey.prefix(v, p))
    let f = bytes.from_str(pasclaims.footer_text(footer))
    let i = bytes.from_str(pasclaims.implicit_text(implicit))
    match p
        PasPublic => paspae.encode([h, payload, f, i])
        PasLocal  =>
            let cut = if bytes.len(payload) < PAS_NONCE_BYTES
                bytes.len(payload)
            else
                PAS_NONCE_BYTES
            paspae.encode([h, bytes.slice(payload, 0, cut), bytes.slice(payload, cut, bytes.len(payload)), f, i])
